        "--release",
        "--flavor",
        "production"
      ]
    },
    {
      "name": "Car Care Plus (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--profile",
        "--flavor",
        "development"
      ]
    },
    {
      "name": "Run All Tests",
      "request": "launch",
